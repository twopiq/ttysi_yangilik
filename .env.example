APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Telegram kanal ---
# BotFather'dan olingan token. Bot manba kanalga ADMIN qilib qo'shilishi shart.
TELEGRAM_BOT_TOKEN=
# Tasodifiy satr: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=
# Kanal chat id (-100... ) yoki @username. Bo'sh bo'lsa hamma kanal qabul qilinadi.
TELEGRAM_CHANNEL_ID=
TELEGRAM_MEDIA_GROUP_WAIT=20

# --- Tarjima ---
# gemini | openai_compatible | claude | manual
TRANSLATE_DRIVER=gemini
TRANSLATE_SOURCE_LOCALE=uz
TRANSLATE_TARGET_LOCALES=ru,en

# gemini: aistudio.google.com/apikey — bepul darajasi bor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# openai_compatible: OpenRouter, Groq, Together, lokal Ollama...
TRANSLATE_OPENAI_BASE_URL=https://openrouter.ai/api/v1
TRANSLATE_OPENAI_API_KEY=
TRANSLATE_OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# claude: pullik API kaliti
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# --- Institut sayti (Laravel) ---
# api      — saytning HTTP endpointiga yuborish
# database — sayt bazasiga to'g'ridan-to'g'ri yozish
SITE_DRIVER=api
SITE_SECTION_ANNOUNCEMENT=elonlar
SITE_SECTION_NEWS=yangiliklar

# SITE_DRIVER=api uchun
SITE_API_ENDPOINT=
SITE_API_TOKEN=

# SITE_DRIVER=database uchun: sayt bazasiga ulanish
SITE_DB_DRIVER=pgsql
SITE_DB_HOST=
SITE_DB_PORT=5432
SITE_DB_DATABASE=
SITE_DB_USERNAME=
SITE_DB_PASSWORD=

# Jadval va ustun nomlari config/site.php -> database bo'limida.
# Sxemani bilish uchun: php artisan site:inspect
SITE_DB_TABLE=news
SITE_DB_LAYOUT=translations

# Rasmlar saytning storage papkasiga ko'chiriladi (mount yoki bir xil server)
SITE_STORAGE_PATH=
SITE_STORAGE_SUBDIR=news
SITE_STORED_PREFIX=news
SITE_URL_TEMPLATE=
